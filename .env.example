# Copy this file to .env and fill in your key. .env is gitignored -- it
# never gets committed, and it's only ever read by server/index.js (a
# Node process), never by the browser-facing React build.

# Required for the chatbot and Documentation Assistant to work. Blank =
# both features return a clear "not configured" error instead of failing
# silently.
ANTHROPIC_API_KEY=

# Optional -- port the proxy listens on. Must match the "proxy" field in
# package.json if you change it.
PROXY_PORT=3001
